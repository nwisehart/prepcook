{
  "name": "prepcook",
  "private": false,
  "version": "0.1.0",
  "main": "index.js",
  "bin": {
    "prepcook": "bin/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=bin/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "coding-agents",
    "claude-code",
    "bug-fixing",
    "root-cause-analysis",
    "pull-requests",
    "kanban",
    "orchestrator",
    "developer-tools",
    "vibe-kanban"
  ],
  "author": "Nick Wisehart",
  "repository": {
    "type": "git",
    "url": "https://github.com/nwisehart/prepcook"
  },
  "homepage": "https://prepcook.dev/",
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "",
  "description": "Prepcook turns a bug report into a reviewed pull request while the engineer who owns it keeps the final say.",
  "devDependencies": {
    "esbuild": "^0.27.2"
  },
  "files": [
    "bin"
  ]
}
