  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id           AS \"id!: Uuid\",\n                email        AS \"email!\",\n                first_name   AS \"first_name?\",\n                last_name    AS \"last_name?\",\n                username     AS \"username?\",\n                created_at   AS \"created_at!\",\n                updated_at   AS \"updated_at!\",\n                agent_password_hash AS \"agent_password_hash?\"\n            FROM users\n            WHERE LOWER(email) = LOWER($1) AND is_agent\n            ",
